{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "watrank-frontend",
	"compatibility_date": "2025-07-14",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".open-next/worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets",
		"not_found_handling": "single-page-application"
	},
	"vars": {
		"NEXT_PUBLIC_API_URL": "https://cf-api.watrank.com"
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "watrank.com/*",
			"zone_name": "watrank.com"
		},
		{
			"pattern": "www.watrank.com/*",
			"zone_name": "watrank.com"
		}
	],
	"workers_dev": true,
	"dev": {
		"port": 3000
	}
}
